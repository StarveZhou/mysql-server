# Design §05: only the first SQL finishes before crash; after attach, uncommitted work
# is from that statement only (no half-second-statement).

--source include/have_innodb_max_16k.inc

--disable_warnings
DROP TABLE IF EXISTS t_stmt1;
--enable_warnings

CREATE TABLE t_stmt1 (a INT PRIMARY KEY, b INT) ENGINE=InnoDB;
INSERT INTO t_stmt1 VALUES (1, 0), (2, 0);

BEGIN;
UPDATE t_stmt1 SET b = 88 WHERE a = 1;

--let $trx_id= query_get_value("SELECT trx_id FROM information_schema.innodb_trx WHERE trx_mysql_thread_id = CONNECTION_ID()", trx_id, 1)

--let $restart_parameters = restart: --recover_preserve_trx=ON
--source include/kill_and_restart_mysqld.inc

--disable_query_log
--eval START TRANSACTION WITH RDS_TRX_ID = $trx_id
--enable_query_log

SELECT a, b FROM t_stmt1 ORDER BY a;

COMMIT;

SELECT a, b FROM t_stmt1 ORDER BY a;

DROP TABLE t_stmt1;
