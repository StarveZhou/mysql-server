# Test: crash with open InnoDB transaction, restart with preserved trx,
# attach session with START TRANSACTION WITH RDS_TRX_ID, commit persists changes.

--source include/have_innodb_max_16k.inc

--disable_warnings
DROP TABLE IF EXISTS t_recover_attach;
--enable_warnings

CREATE TABLE t_recover_attach (a INT PRIMARY KEY, b INT) ENGINE=InnoDB;
INSERT INTO t_recover_attach VALUES (1, 0);

BEGIN;
UPDATE t_recover_attach SET b = 100 WHERE a = 1;

--let $trx_id= query_get_value("SELECT trx_id FROM information_schema.innodb_trx LIMIT 1", trx_id, 1)

--echo # Unclean shutdown then restart (kill_and_restart; recover_preserve_trx=ON)
--let $restart_parameters= restart: --recover_preserve_trx=ON
--source include/kill_and_restart_mysqld.inc

--echo # After recovery: uncommitted update not visible yet
SELECT b FROM t_recover_attach WHERE a = 1;

--echo # Attach preserved transaction by InnoDB trx id
--disable_query_log
--eval START TRANSACTION WITH RDS_TRX_ID = $trx_id
--enable_query_log

SELECT b FROM t_recover_attach WHERE a = 1;

COMMIT;

--echo # Commit must persist (InnoDB must run trx_commit_for_mysql for attached trx)
SELECT b FROM t_recover_attach WHERE a = 1;

SELECT COUNT(*) AS active_trx FROM information_schema.innodb_trx;

DROP TABLE t_recover_attach;
